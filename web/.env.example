# Plote web — environment (SPEC §16.4). Copy to .env.local. Every value has a testnet default,
# so the app builds and renders with no env at all; features that need a secret return a clear 503.

# ---------------------------------------------------------------- public (shipped to the browser)
# testnet (default) | mainnet — mainnet builds the 1Click demo variant (Path B) and hides /faucet
NEXT_PUBLIC_NETWORK=testnet
# Primary RPC and failover RPC for view calls
NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_RPC_FALLBACK=https://rpc.testnet.near.org
# Comma-separated estate accounts this deployment shows (slug = first label, e.g. /estates/harmattan-court)
NEXT_PUBLIC_ESTATES=harmattan-court.plote.testnet,baobab-heights.plote.testnet,playground.plote.testnet
# USDC token: mock on testnet; Circle native USDC on mainnet (17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1)
NEXT_PUBLIC_USDC_ID=musdc.plote.testnet
# NearBlocks base for every ↗ link
NEXT_PUBLIC_EXPLORER=https://testnet.nearblocks.io
# Public URL of this deployment (emails, OG images, NFT reference, share links). Set it in production. If unset, a
# Vercel deployment falls back to https://$VERCEL_PROJECT_PRODUCTION_URL (preview: $VERCEL_URL); only local dev uses localhost
NEXT_PUBLIC_APP_URL=https://plote-vert.vercel.app
# Supabase project (public anon key; RLS allows select on events, chipins, evidence_files)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: parent of estates not listed above (default plote.testnet), repo link, other-network build links, FX endpoint
NEXT_PUBLIC_ROOT_ACCOUNT=plote.testnet
NEXT_PUBLIC_GITHUB_URL=https://github.com/linoxbt/Plote
NEXT_PUBLIC_MAINNET_APP_URL=
NEXT_PUBLIC_TESTNET_APP_URL=
# Mainnet build only: the Mainnet Lite unit account /pay sends a real 1Click payment to (same value as MAINNET_UNIT_ACCOUNT below)
NEXT_PUBLIC_MAINNET_UNIT_ACCOUNT=
# USD→NGN rate for naira hints (any endpoint returning { rates: { NGN } })
NEXT_PUBLIC_FX_URL=https://open.er-api.com/v6/latest/USD

# ---------------------------------------------------------------- server only (never NEXT_PUBLIC_)
# Supabase service role: signed upload URLs, event cache writes, chip-ins, notify subscriptions
SUPABASE_SERVICE_ROLE_KEY=
# Relayer (testnet build): pays gas for relayed surveyor calls (NEP-366 meta-transactions)
RELAYER_ACCOUNT_ID=relayer.plote.testnet
RELAYER_PRIVATE_KEY=
# Methods the relayer will pay for (surveyor calls to a configured estate; anything outside open_capture,submit_evidence,qs_sign is ignored)
RELAYER_ALLOWED_METHODS=open_capture,submit_evidence,qs_sign
# Optional gas cap per relayed call, in Tgas: a whole number, clamped to 1..300 (default 300; not a number → 300)
RELAYER_MAX_GAS_TGAS=300
# Reporter: the estates' verdict_relayer / deposit reporter. Signs submit_verdict (/api/verify) and report_deposit
# (/api/oneclick/status). A separate hot key from the relayer; on testnet it falls back to RELAYER_* when both are
# unset. Required on a mainnet build. Must equal each estate's verdict_relayer
REPORTER_ACCOUNT_ID=
REPORTER_PRIVATE_KEY=
# 1Click (NEAR Intents) API base (default https://1click.chaindefuser.com). JWT optional (without it a 0.2% fee applies)
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
# Mainnet Lite: the one unit account that may receive 1Click deliveries without an estate contract
MAINNET_UNIT_ACCOUNT=
# Mainnet build only: the relayer account and key (tiny balance). Both required; never falls back to RELAYER_*
MAINNET_RELAYER_ACCOUNT_ID=
MAINNET_RELAYER_PRIVATE_KEY=
# NearBlocks API key for /api/cron/poll (receipt listing). Optional, but the keyless tier rate-limits quickly
NEARBLOCKS_API_KEY=
# Resend (milestone emails, C7). Emails are off (GET /api/notify/status → configured:false) unless BOTH are set.
# RESEND_FROM has no default: it must be a sender on a domain you verified in Resend, e.g. Plote <notify@your-domain>
RESEND_API_KEY=
RESEND_FROM=
# HMAC key for confirm/unsubscribe links (any long random string, different from CRON_SECRET). Required for emails:
# without it /api/notify/status says configured:false. Unsubscribe links sent earlier (signed with CRON_SECRET) still work
NOTIFY_SECRET=
# Shared secret for manual /api/cron/poll runs (poll.yml) and the detailed /api/health view (header x-cron-secret)
CRON_SECRET=
# Secret the Supabase pg_cron scheduler sends to /api/cron/poll every 5 minutes (migrations 0005 + 0007; the same
# value is stored in Supabase Vault as plote_poll_secret). Accepted by the poller only, not by /api/health
POLL_SECRET=
# Optional Slack/Discord webhook: low balances, estates or transactions the poller couldn't read
ALERT_WEBHOOK_URL=
# Optional extra accounts to watch for < 0.5 NEAR (comma-separated), besides each estate's developer and payout accounts
MONITOR_ACCOUNTS=
# The poller deletes flagged evidence files (playground files > 14 days and unreferenced on-chain, late or wrong-size
# uploads) by default on a production deployment. 0 = report only; 1 = delete on any deployment
STORAGE_CLEANUP_DELETE=

# HTTPS fallback for photo checks (SPEC 6.6). Only needed if an estate uses verify_mode "https"
# or a yield/resume check errors. The reporter above must be the estate's verdict_relayer.
OUTLAYER_HTTPS_URL=        # e.g. https://api.outlayer.io/call/<owner>/<project>
OUTLAYER_PAYMENT_KEY=
