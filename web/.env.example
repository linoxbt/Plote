# Plote web — environment (SPEC §16.4). Copy to .env.local. Every value has a testnet default,
# so the app builds and renders with no env at all; features that need a secret return a clear 503.

# ---------------------------------------------------------------- public (shipped to the browser)
# testnet (default) | mainnet — mainnet builds the 1Click demo variant (Path B) and hides /faucet
NEXT_PUBLIC_NETWORK=testnet
# Primary RPC and failover RPC for view calls
NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_RPC_FALLBACK=https://rpc.testnet.near.org
# Comma-separated estate accounts this deployment shows (slug = first label, e.g. /estates/harmattan-court)
NEXT_PUBLIC_ESTATES=harmattan-court.plote.testnet,baobab-heights.plote.testnet,playground.plote.testnet
# USDC token: mock on testnet; Circle native USDC on mainnet (17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1)
NEXT_PUBLIC_USDC_ID=musdc.plote.testnet
# NearBlocks base for every ↗ link
NEXT_PUBLIC_EXPLORER=https://testnet.nearblocks.io
# Public URL of this deployment (OG images, NFT reference, share links)
NEXT_PUBLIC_APP_URL=https://plote.vercel.app
# Supabase project (public anon key; RLS allows select on events, chipins, evidence_files)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: parent of estates not listed above (default plote.testnet), repo link, other-network build links, FX endpoint
NEXT_PUBLIC_ROOT_ACCOUNT=plote.testnet
NEXT_PUBLIC_GITHUB_URL=https://github.com/<you>/plote
NEXT_PUBLIC_MAINNET_APP_URL=
NEXT_PUBLIC_TESTNET_APP_URL=
NEXT_PUBLIC_FX_URL=https://open.er-api.com/v6/latest/USD

# ---------------------------------------------------------------- server only (never NEXT_PUBLIC_)
# Supabase service role: signed upload URLs, event cache writes, chip-ins, notify subscriptions
SUPABASE_SERVICE_ROLE_KEY=
# Relayer (NEP-366 meta-transactions; pays gas for surveyor calls and 1Click post-delivery sync)
RELAYER_ACCOUNT_ID=relayer.plote.testnet
RELAYER_PRIVATE_KEY=
# Methods the relayer will pay for (receiver must be a configured estate, or a unit account for sync_deposits)
RELAYER_ALLOWED_METHODS=open_capture,submit_evidence,qs_sign,sync,sync_deposits,sweep_unattributed
# Optional gas cap per relayed call, in Tgas (default 300)
RELAYER_MAX_GAS_TGAS=300
# 1Click (NEAR Intents). JWT optional (without it a 0.2% fee applies)
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
# Mainnet Lite: the one unit account that may receive 1Click deliveries without an estate contract
MAINNET_UNIT_ACCOUNT=
# Mainnet relayer (tiny balance) for the post-SUCCESS sync; account defaults to RELAYER_ACCOUNT_ID
MAINNET_RELAYER_ACCOUNT_ID=
MAINNET_RELAYER_PRIVATE_KEY=
# Optional NearBlocks API key for /api/cron/poll
NEARBLOCKS_API_KEY=
# Resend (milestone emails, C7)
RESEND_API_KEY=
RESEND_FROM=Plote <notify@plote.app>
# Shared secret for /api/cron/poll (header x-cron-secret); also signs unsubscribe links
CRON_SECRET=

# HTTPS fallback for photo checks (SPEC 6.6). Only needed if an estate uses verify_mode "https"
# or a yield/resume check errors. The relayer above must be the estate's verdict_relayer.
OUTLAYER_HTTPS_URL=        # e.g. https://api.outlayer.io/call/<owner>/<project>
OUTLAYER_PAYMENT_KEY=
